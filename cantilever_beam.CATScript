' CATIA V5 CATScript - create the 300 x 30 x 6 mm cantilever beam part.
' Run from CATIA: Tools > Macro > Macros, select this CATScript, Run.
' The 300 mm span runs along +Z from the clamped end at z=0; section is in XY.
On Error Resume Next
Set CATIA = GetObject(, "CATIA.Application")
If Err.Number <> 0 Then
  Err.Clear
  Set CATIA = CreateObject("CATIA.Application")
End If
On Error GoTo 0
CATIA.Visible = True
Set partDoc = CATIA.Documents.Add("Part")
Set part = partDoc.Part
Set body = part.Bodies.Item("PartBody")
Set sketch = body.Sketches.Add(part.OriginElements.PlaneXY)
sketch.Name = "Beam section 30x6 mm"
Set factory2D = sketch.OpenEdition()
Set l1 = factory2D.CreateLine(-15, -3, 15, -3)
Set l2 = factory2D.CreateLine(15, -3, 15, 3)
Set l3 = factory2D.CreateLine(15, 3, -15, 3)
Set l4 = factory2D.CreateLine(-15, 3, -15, -3)
sketch.CloseEdition()
Set shapeFactory = part.ShapeFactory
Set pad = shapeFactory.AddNewPad(sketch, 300)
pad.Name = "Cantilever beam - 300 mm span"
part.Update()
' Save the editable CATPart into this task's outputs directory.
partDoc.SaveAs "C:/Users/DHARUN/Documents/Codex/2026-11-26/task-2-structural-simulation-fea-perform/outputs/cantilever_beam.CATPart"
MsgBox "Beam part created and saved. Use Generative Structural Analysis (if licensed) to define the clamp, loads, mesh, and solve.", vbInformation, "CATIA V5 beam model"

